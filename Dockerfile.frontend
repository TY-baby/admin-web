FROM node:18-alpine AS pc-builder
ENV LANG=C.UTF-8
WORKDIR /app
COPY web-pc/package*.json ./
RUN npm install
COPY web-pc/ .
RUN npm run build

FROM node:18-alpine AS admin-builder
ENV LANG=C.UTF-8
WORKDIR /app
COPY web-front/package*.json ./
RUN npm install
COPY web-front/ .
RUN npm run build

FROM nginx:alpine
RUN sed -i 's/# charset/charset/' /etc/nginx/nginx.conf 2>/dev/null; true
COPY --from=pc-builder /app/dist /usr/share/nginx/html
COPY --from=admin-builder /app/dist /usr/share/nginx/html/admin
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]